rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'sadallah771@gmail.com';
    }

    // Registrations collection: allow create for all students, allow read and update for admin management
    match /registrations/{registrationId} {
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.fullName.size() > 0
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 8;

      allow read, update, delete: if true;
    }

    // Site settings & editable courses collection
    match /site_settings/{docId} {
      allow read, write: if true;
    }

    match /site_courses/{courseId} {
      allow read, write: if true;
    }

    // Reviews collection (public read, open write)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // AI Leads & Client CRM Interactions captured by GC58 AI
    match /ai_leads/{leadId} {
      allow read, write: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
